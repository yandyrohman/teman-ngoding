#!/bin/bash
# Terminal khusus Teman Ngoding: Ptyxis (dari folder terminal/) dengan app-id & setting sendiri,
# jadi tidak mengubah Ptyxis bawaan. Tiap jendela bisa punya tema sendiri lewat
# menu ☰ → "Tema Sesi Ini…". Kalau belum terpasang, pakai Ptyxis bawaan.
PREFIX=/usr/local/lib/teman-ngoding/terminal

if [ -x "$PREFIX/bin/ptyxis" ]; then
    export GSETTINGS_SCHEMA_DIR="$PREFIX/share/glib-2.0/schemas${GSETTINGS_SCHEMA_DIR:+:$GSETTINGS_SCHEMA_DIR}"
    export XDG_DATA_DIRS="$PREFIX/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
    exec "$PREFIX/bin/ptyxis" "$@"
fi

exec ptyxis "$@"
