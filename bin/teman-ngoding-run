#!/bin/bash
# Jalankan CLI AI sebagai root: teman-ngoding-run [claude|gemini|codex|opencode|deepseek] [argumen...]
# Karakter DeepSeek memakai DeepSeek Harness (dsh): `dsh web` menyalakan server lokal
# lalu membuka Web UI-nya di Chrome; jendela terminal ini menjaga servernya tetap hidup.
# Karakter Gemini memakai Antigravity CLI (agy); Gemini CLI tidak lagi menerima login akun Google pribadi.
# Dipakai oleh "Teman Ngoding" (lewat teman-ngoding-launch). Halaman login yang
# dibuka CLI diarahkan ke Chrome milik user (bukan root) lewat open-in-user-chrome.

agent="${1:-claude}"
shift

case "$agent" in
    claude) bin=/root/.local/bin/claude; name="Claude Code" ;;
    gemini) bin=/root/.local/bin/agy; name="Antigravity CLI" ;;
    # Codex langsung mode auto (seperti auto mode Claude Code): permintaan izin dinilai
    # reviewer otomatis, bukan ditanyakan ke user satu per satu
    codex) bin=codex; name="Codex CLI"; set -- --approve-for-me "$@" ;;
    opencode) bin=opencode; name="OpenCode" ;;
    deepseek) bin=dsh; name="DeepSeek Harness"; [ $# -eq 0 ] && set -- web ;;
    *) echo "Karakter tidak dikenal: $agent" >&2; exit 2 ;;
esac

cd "$HOME" 2>/dev/null || cd /

# CLI belum terpasang (mis. dilewati saat install): tawarkan pasang versi terbaru
if ! sudo /usr/local/bin/teman-ngoding-install-cli --check "$agent"; then
    echo "📦 $name belum terpasang."
    read -rp "Pasang sekarang (versi terbaru)? [Y/n] " answer
    case "$answer" in
        [nN]*) exit 0 ;;
    esac
    if ! sudo /usr/local/bin/teman-ngoding-install-cli "$agent"; then
        echo
        read -rp "Gagal memasang $name. Tekan Enter untuk menutup..."
        exit 1
    fi
    echo
fi

# API key (kalau dipilih lewat "Ganti Akun"): Gemini di /root/.gemini/.env,
# DeepSeek di /root/.deepseek/.env (DEEPSEEK_API_KEY)
with_env=()
case "$agent" in
    gemini) envfile=/root/.gemini/.env ;;
    deepseek) envfile=/root/.deepseek/.env ;;
    *) envfile= ;;
esac
[ -n "$envfile" ] && with_env=(bash -c 'set -a; [ -r "$ENVFILE" ] && . "$ENVFILE"; set +a; exec "$0" "$@"')

# Claude in Chrome: ekstensinya ada di Chrome milik user, bukan root. Tautkan dulu
# supaya Claude Code (root) mendeteksinya; lihat lib/link-user-chrome.
if [ "$agent" = claude ]; then
    with_env=(bash -c '/usr/local/lib/teman-ngoding/link-user-chrome; exec "$0" "$@"')
fi

sudo env \
    IS_SANDBOX=1 \
    HOME=/root \
    PATH="/usr/local/lib/teman-ngoding/bin:/root/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin" \
    BROWSER=/usr/local/lib/teman-ngoding/open-in-user-chrome \
    TEMAN_NGODING_USER="$USER" \
    WAYLAND_DISPLAY="$WAYLAND_DISPLAY" DISPLAY="$DISPLAY" \
    COLORTERM="${COLORTERM:-truecolor}" \
    TERM="${TERM:-xterm-256color}" \
    ENVFILE="$envfile" \
    "${with_env[@]}" "$bin" "$@"
status=$?

if [ "$status" -ne 0 ]; then
    echo
    read -rp "$name keluar dengan kode $status. Tekan Enter untuk menutup..."
fi
